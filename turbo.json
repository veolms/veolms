{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@veolms/web#build": {
      "outputs": ["build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:lan": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.mjs",
        "tsconfig.json",
        "../../eslint.config.js"
      ],
      "outputs": [".eslintcache/**"]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "outputs": []
    }
  }
}
