{
  "name": "@veolms/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location .eslintcache/",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache/",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env src/seed.ts",
    "seed:admins": "node --env-file-if-exists=../../.env src/seed-admins.ts",
    "reset": "node --env-file-if-exists=../../.env src/reset.ts",
    "migration:create": "node ./scripts/create-migration.ts"
  },
  "dependencies": {
    "@veolms/config": "workspace:*",
    "@veolms/contracts": "workspace:*",
    "kysely": "catalog:",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
