{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3StorageAndBuildBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET_NAME}",
        "arn:aws:s3:::${S3_BUCKET_NAME}/*",
        "arn:aws:s3:::${S3_BUILD_BUCKET}",
        "arn:aws:s3:::${S3_BUILD_BUCKET}/*"
      ]
    },
    {
      "Sid": "EC2WorkerProvisioningAndSpotManagement",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeImages",
        "ec2:CreateTags",
        "ec2:RequestSpotInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassWorkerRoleToEC2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/VeoLMSWorkerRole"
    },
    {
      "Sid": "ResolveDebianAmiParameter",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:*::parameter/aws/service/debian/*"
    },
    {
      "Sid": "EventBridgeSchedulerControl",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "scheduler:GetSchedule"
      ],
      "Resource": "arn:aws:scheduler:${AWS_REGION}:${AWS_ACCOUNT_ID}:schedule/default/*"
    },
    {
      "Sid": "LambdaFunctionInvocation",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:veolms-fleet-manager",
        "arn:aws:lambda:${AWS_REGION}:${AWS_ACCOUNT_ID}:function:veolms-video-metadata-probe"
      ]
    },
    {
      "Sid": "CloudWatchLogsFullAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
