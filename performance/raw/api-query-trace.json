    "queryMaxMs": 54.5554,
    "queryTexts": [
      "select * from \"courses\" where \"creator_id\" = $1 and \"status\" = $2 and \"deleted_at\" is null order by \"created_at\" desc",
      "select \"courses\".\"id\", \"courses\".\"slug\", \"courses\".\"title\", \"courses\".\"short_description\", \"courses\".\"difficulty\", \"courses\".\"instructor_alias\", \"courses\".\"thumbnail_media_id\", (select \"thumbnail_media\".\"metadata\" from \"media_assets\" as \"thumbnail_media\" where \"thumbnail_media\".\"id\" = \"courses\".\"thumbnail_media_id\") as \"thumbnail_metadata\", (select \"thumbnail_media\".\"storage_key\" from \"media_assets\" as \"thumbnail_media\" where \"thumbnail_media\".\"id\" = \"courses\".\"thumbnail_media_id\") as \"thumbnail_storage_key\", \"categories\".\"name\" as \"category_name\", \"users\".\"display_name\" as \"creator_display_name\", \"course_pricing\".\"pricing_type\", \"course_pricing\".\"price\", \"course_pricing\".\"currency\", \"course_pricing\".\"sale_price\", \"course_settings\".\"certificate_enabled\", \"course_settings\".\"estimated_duration\", (select count(\"id\") as \"count\" from \"course_sections\" where \"course_sections\".\"course_id\" = \"courses\".\"id\" and \"course_sections\".\"deleted_at\" is null) as \"total_sections\", (select count(\"id\") as \"count\" from \"course_lessons\" where \"course_lessons\".\"course_id\" = \"courses\".\"id\" and \"course_lessons\".\"is_published\" = $1 and \"course_lessons\".\"deleted_at\" is null) as \"total_lessons\", (select coalesce(sum(\"lesson_media\".\"duration_seconds\"), 0) as \"sum\" from \"course_lessons\" left join \"media_assets\" as \"lesson_media\" on \"lesson_media\".\"id\" = \"course_lessons\".\"content_media_id\" where \"course_lessons\".\"course_id\" = \"courses\".\"id\" and \"course_lessons\".\"is_published\" = $2 and \"course_lessons\".\"deleted_at\" is null) as \"lesson_duration_seconds\" from \"courses\" left join \"categories\" on \"categories\".\"id\" = \"courses\".\"category_id\" and \"categories\".\"deleted_at\" is null left join \"users\" on \"users\".\"id\" = \"courses\".\"creator_id\" and \"users\".\"is_deleted\" = $3 left join \"course_pric