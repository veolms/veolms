# Database Settings
POSTGRES_DB=veolms
POSTGRES_USER=veolms
POSTGRES_PASSWORD=veolms
POSTGRES_PORT=5433
DATABASE_URL=postgresql://veolms:veolms@localhost:5433/veolms

# Connection pool tuning (per process; see packages/database/src/client.ts).
# Size DATABASE_POOL_MAX against the database's connection limit times the
# number of processes (API instances + notification worker + jobs).
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_APPLICATION_NAME=veolms

# API Server Settings
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development
API_DEV_PRETTY_LOGS=true
API_DOCS_ENABLED=true
# Development aid: delay every API call by this many milliseconds to see how the
# app behaves on a slow connection. 0 or unset = off. Ignored in production.
# API_RESPONSE_DELAY_MS=2000
# The course overview carries every lesson's description. The lesson page reads the
# open lesson's description from its own endpoint, so this can be set to false once
# no browser is still on a web build from before that endpoint (one release later).
# false = each lesson goes out with a null description; the editor is unaffected.
# COURSE_OVERVIEW_LESSON_DESCRIPTIONS=true
# An extra payment taken by the gateway (a second payment for a paid order, or a late
# payment for something the buyer already has) is refunded to the buyer automatically.
# false = only list it for staff.
# AUTO_REFUND_EXTRA_PAYMENTS=true
# Days a reported bank transfer keeps the gateway closed for that purchase while staff
# have not answered it.
# MANUAL_PAYMENT_BLOCK_DAYS=7
# Only set behind a proxy that serves the docs and the API on different origins,
# or that mounts the API under a path prefix. Unset, the docs target their own origin.
# API_PUBLIC_URL=https://api.example.com

# Web Client Settings
WEB_PORT=3000
WEB_URL=http://localhost:3000
VITE_API_BASE_URL=/v1

# Additional allowed CORS origins (comma-separated, e.g. https://dev.veolms.org,https://veolms.org)
# CORS_ORIGINS=http://localhost:3000,https://dev.veolms.org

# Optional direct origin for the local course HLS/video and thumbnail assets.
# When set, this takes precedence over VITE_CDN_URL for built-in course media.
# VITE_COURSE_MEDIA_BASE_URL=https://your-public-r2-domain.example
STATIC_BUILD_API_URL=http://localhost:4000/v1
# Browser-facing CDN URL. Use a full domain, or /cdn when the host routes
# /cdn/* to the Cloudflare Worker. Keep this equal to CDN_URL below.
VITE_CDN_URL=/cdn
# Public address of the site (scheme and host, no path). Optional. When set, prerendered
# course pages carry og:url, a canonical link and an absolute og:image for share previews.
# VITE_SITE_URL=https://academy.example.com
# API/Worker CDN URL. The web build falls back to this when VITE_CDN_URL is unset.
CDN_URL=/cdn

# cdn configuration
CDN_URL=https://cdn.example.com
CDN_TOKEN_TTL_SECONDS=900
CDN_HLS_TOKEN_TTL_SECONDS=60
CDN_PUBLIC_FOLDERS=public,
CDN_PRIVATE_FOLDERS=protected
CDN_SIGNING_SECRET=32_character_secret_key_for_cdn_signing
# Both CDN values are used for course video/HLS, thumbnails, and media URLs.

# Security Configurations
# Must be at least 32 characters long
SESSION_SECRET=default_session_secret_at_least_32_chars_long
# TTL in ms of what is cached per signed-in user: the sign-in, the roles
# behind permission checks, the side navigation (0 disables). Revocation,
# role and MFA changes clear them in every process at once; this bounds only
# a change the cache bus did not carry.
# SESSION_AUTH_CACHE_TTL_MS=30000
# Process-local cache TTL in ms (0 disables, at most 30000) for a course as
# every visitor sees it (signed-out overview, public curriculum). A change
# through the API clears the course at once in that process; other instances
# see it within this TTL.
# COURSE_CACHE_TTL_MS=30000
# Every process-local cache (false sends every read to the database).
# CACHE_ENABLED=true
# Tells the other API processes when cached data changes (Postgres
# LISTEN/NOTIFY, one connection per process; needs a direct or session-mode
# connection, not a transaction-mode pooler).
# CACHE_BUS_ENABLED=true
MFA_ENCRYPTION_KEY=default_mfa_encryption_key_at_least_32_chars_long
SETUP_TOKEN=veo_setup_token_123

# WebAuthn Passkeys Configurations
RP_ID=localhost
# The academy's name in passkey prompts, authenticator apps, texts and
# notices, and in emails until the academy's own name is set in its settings.
# (Formerly RP_NAME, which is still read when this is not set.)
ACADEMY_NAME=VeoLMS

# TOTP Settings
TOTP_STEP_SECONDS=30
TOTP_BACKWARD_STEPS=1
TOTP_FORWARD_STEPS=0

# Seconds before another one-time code can be sent to the same email address
# or mobile number (1-3600). The API enforces it and the login form counts it
# down, so restart the web dev server or rebuild the web app after changing it.
# Keep 60 on a deployed environment; a few seconds is handy for local testing.
OTP_RESEND_COOLDOWN_SECONDS=60
# Minutes a sign-in code stays valid (1 to 60).
OTP_TTL_MINUTES=10
# Ask learners to verify a mobile number (by a texted code) before their
# first purchase or enrolment. Sign-up asks only for an email. Needs a working
# SMS provider (see SMS_PROVIDER), so it is off unless turned on here.
REQUIRE_VERIFIED_PHONE_FOR_ENROLLMENT=false

# One-time codes a single network address may request in any ten minutes,
# across every email address and number. Counted in the database, so it holds
# across API instances. Raise it where many learners share one address (a
# campus or office network). 0 turns the limit off.
OTP_IP_WINDOW_LIMIT=50

# Different addresses and numbers with no account that a single network
# address may send a sign-up code to in a day. 0 turns the limit off.
OTP_IP_DAILY_SIGNUP_LIMIT=200

# Megabytes one account may upload to discussions and notes in any 24 hours
# (a single file is capped at 50 MB separately). The second value applies to
# accounts with any role beyond student. 0 means no limit.
DISCUSSION_UPLOAD_DAILY_QUOTA_MB=500
DISCUSSION_UPLOAD_DAILY_QUOTA_STAFF_MB=5000

# Days an upload that was never attached to a post is kept before
# "pnpm --filter @veolms/api purge:discussion-uploads -- --apply" may remove it.
DISCUSSION_UPLOAD_ORPHAN_RETENTION_DAYS=7

# How often, in hours, the API itself removes those uploads (1 to 168; 24 is a
# sensible value). 0 leaves it off: nothing is removed unless you set this or
# run the script above. In production it also needs the storage credentials.
DISCUSSION_UPLOAD_PURGE_INTERVAL_HOURS=0

# Shared test accounts that sign in with a fixed six-digit code instead of an
# emailed one, as comma-separated email:code pairs. No email is sent and the
# resend limits do not apply. Anyone who knows a pair can sign in as that
# account, so list only addresses kept for testing; an account holding any
# role other than student is never given its fixed code. Leave unset to
# disable.
# TEST_LOGIN_ACCOUNTS=tester1@example.com:482913,tester2@example.com:771204

# Accepts "mock_<email>" OAuth codes, bypassing the provider round-trip and the
# state/CSRF check. Only honoured when NODE_ENV=development as well. Never
# enable this on a deployed environment.
OAUTH_ALLOW_MOCK_CODES=false

# When set to true, MFA enforcement, step-up challenges, and mandatory MFA
# enrollment are skipped for every staff account (admins, instructors and all
# team roles). For development and testing only; keep it false in production.
SKIP_ADMIN_MFA=false

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery Configuration (SMTP)
# EMAIL_TRANSPORT selects how mail leaves the process: "smtp" dispatches, and
# "console" only renders the message to the log. Leave it unset to default to
# console in development while SMTP_HOST is still localhost, and smtp otherwise
# (so a dev environment with real credentials does deliver).
# EMAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@veolms.org
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# One-shot notification worker settings. Run with `pnpm notifications:process`
# from an external scheduler; retry delays are comma-separated seconds.
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_LEASE_SECONDS=300
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=60,300,1800,7200
# false: course-wide notifications (course published, quiz assigned) stay
# in-app only and send no email.
# NOTIFICATION_COURSE_WIDE_EMAIL=true
NOTIFICATION_OUTBOX_RETENTION_DAYS=30

# SMS Delivery Configuration
# Country calling codes one-time codes may be sent to, comma separated (e.g. "+91" or "+91,+1").
# Leave unset to allow every country. SMS is paid per message — set this to the countries you serve.
# SMS_ALLOWED_COUNTRY_CODES=+91
# Active provider: "auto" (default, prefers MSG91 when configured), "msg91", "vonage", "twilio", "console"
SMS_PROVIDER=auto

# MSG91 SMS Provider (Flow API)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_API_URL=https://control.msg91.com/api/v5/flow

# Vonage / Nexmo SMS Provider
SMS_PRIMARY_URL=https://api.nexmo.com/v1/messages
SMS_PRIMARY_KEY=
SMS_PRIMARY_SECRET=

# Twilio SMS Provider (optional backup or standalone provider)
SMS_BACKUP_URL=
SMS_BACKUP_SID=
SMS_BACKUP_TOKEN=
SMS_BACKUP_FROM=+1234567890

# S3 / Object Storage Configuration
# The API and media worker should use the same bucket and endpoint. The media
# worker accepts S3_* aliases for fleet deployments, but STORAGE_* wins when
# both are present.
STORAGE_ENDPOINT=
# Keep the bucket private. CDN_URL controls direct delivery; these folders are
# classified by the CDN Worker, with manifests public and protected segments
# requiring the short-lived token issued by the API.
CDN_SIGNING_SECRET=default_cdn_signing_secret_at_least_32_chars_long
CDN_TOKEN_TTL_SECONDS=900
CDN_HLS_TOKEN_TTL_SECONDS=900
CDN_PUBLIC_FOLDERS=public,thumbnails,course-hls,course-videos
CDN_PRIVATE_FOLDERS=protected,media,transcoded

STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=veolms-media
STORAGE_FORCE_PATH_STYLE=false

# ==============================================================================
# Commerce & Payment Gateway Configuration
# ==============================================================================
# Primary Payment Gateway (Razorpay)
# Required in production — server boot fails if these are missing (see packages/config).
# In development, leave blank to use the mock gateway fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret used to verify incoming Razorpay payment & refund webhook signatures
# (/webhooks/payments/razorpay).
RAZORPAY_WEBHOOK_SECRET=

# Dodo Payments (merchant of record) for buyers outside India. Off while the API
# key is blank. Keys are per mode: a dodo test key with test_mode, a live key
# with live_mode. The webhook key is the endpoint's secret (whsec_…) for
# <API URL>/v1/webhooks/dodo, from the Dodo dashboard (Developer → Webhooks).
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Dodo charges the buyer's tax as the seller. false: added on top of the price
# at checkout (the buyer pays it); true: taken out of the price (we receive less).
DODO_PAYMENTS_TAX_INCLUSIVE=false

# Cashfree Payments (India, and cards/PayPal from abroad once Cashfree enables
# international payments). Off while the keys are blank. App ID and secret key
# from the Cashfree dashboard (Developers → API Keys), per environment: sandbox
# keys with sandbox, production keys with production. Webhooks are signed with
# the secret key: add <API URL>/v1/webhooks/cashfree in Developers → Webhooks.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=sandbox

# Which gateway a new checkout opens, by the buyer's country (ISO codes, "*" for
# every other country). Pairs naming a gateway that is not set up are skipped.
# Buyers whose country is unknown get PAYMENT_GATEWAY_DEFAULT.
PAYMENT_GATEWAY_DEFAULT=razorpay
PAYMENT_GATEWAY_BY_COUNTRY=IN:razorpay,*:dodo
# The request header with the buyer's country (Cloudflare sends cf-ipcountry).
PAYMENT_COUNTRY_HEADER=cf-ipcountry
# Development only: the country of every checkout on a local API (no Cloudflare
# in front). With the rules above, US opens Dodo Payments, IN opens Razorpay;
# PAYMENT_GATEWAY_BY_COUNTRY=IN:razorpay,*:cashfree sends US to Cashfree.
# PAYMENT_TEST_COUNTRY=US

# Note: Custom / merchant gateway credentials configured via API (/payments/gateway-config)
# are encrypted at rest using AES-256-GCM with MFA_ENCRYPTION_KEY or SESSION_SECRET.

# ==============================================================================
# Video Processing & Transcoding Dispatch Strategy
# ==============================================================================
# 1. "mediaconvert" (inbuilt): Direct AWS Elemental MediaConvert SDK integration
# 2. "direct" (api-server): In-process transcoding on API server (stubbed for future)
# 3. "distributed" (worker-vm / lambda): Transcoding on external VM / Lambda / Fleet Manager
VIDEO_DISPATCH_STRATEGY=mediaconvert

# AWS MediaConvert Settings (Strategy 1)
# For real AWS MediaConvert, set MEDIACONVERT_ROLE_ARN and optionally MEDIACONVERT_ENDPOINT.
# For local MediaConvert emulator or custom fleet endpoint: http://localhost:4002
# MEDIACONVERT_ENDPOINT=http://localhost:4002
# MEDIACONVERT_REGION=ap-south-1
# MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/MediaConvertRole
# MEDIACONVERT_QUEUE_ARN=
# MEDIACONVERT_ACCESS_KEY_ID=
# MEDIACONVERT_SECRET_ACCESS_KEY=
# MEDIACONVERT_WEBHOOK_URL=http://localhost:4000/v1/webhooks/mediaconvert
# MEDIACONVERT_WEBHOOK_SECRET=

# Fleet Manager Trigger Configuration (Serverless Video Processing - Strategy 3)
# Option 1: Direct HTTP / Lambda Function URL trigger
# FLEET_MANAGER_TRIGGER_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
# Option 2: AWS Lambda SDK invoke
# FLEET_MANAGER_LAMBDA_NAME=veolms-fleet-manager
# FLEET_MANAGER_LAMBDA_REGION=us-east-1
# For local Floci, the infra wizard writes host-side endpoint settings to
# apps/fleet-manager/.env and apps/media-worker/.env. The Fleet CLI reads those
# generated app env files; the root .env is used for Compose interpolation.
# AWS_ENDPOINT_URL=http://localhost:4566
FLEET_MANAGER_HEARTBEAT_SECONDS=10

# Local Docker Fleet (set DOCKER_SOCKET_GID to `stat -c '%g' /var/run/docker.sock` on Linux)
# DOCKER_SOCKET_GID=0

TRUST_PROXY=false
# Behind a reverse proxy or load balancer, set this to the number of proxies in
# front of the API (TRUST_PROXY=1) or to their addresses / CIDR blocks. The
# client address every per-address limit uses comes from it.
# Left "false" behind a proxy, every visitor appears to come from the proxy.
# Avoid "true": it accepts whatever X-Forwarded-For a client sends, which lets
# a caller pick their own address and step around those limits.
# TRUST_PROXY=1

# YouTube playlist importer (`pnpm import:youtube`). Disk-backed scratch dir;
# do not use /tmp on Ubuntu (often tmpfs). Defaults to /var/lib/veolms/import,
# ~/.veolms/tmp, or /var/tmp.
# VEOLMS_IMPORT_TMP=/var/lib/veolms/import
