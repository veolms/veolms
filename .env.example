# Database Settings
POSTGRES_DB=veolms
POSTGRES_USER=veolms
POSTGRES_PASSWORD=veolms
POSTGRES_PORT=5433
DATABASE_URL=postgresql://veolms:veolms@localhost:5433/veolms

# API Server Settings
API_HOST=127.0.0.1
API_PORT=4000
NODE_ENV=development
API_DEV_PRETTY_LOGS=true
API_DOCS_ENABLED=true
# Only set behind a proxy that serves the docs and the API on different origins,
# or that mounts the API under a path prefix. Unset, the docs target their own origin.
# API_PUBLIC_URL=https://api.example.com

# Web Client Settings
WEB_PORT=3000
WEB_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
# Optional direct origin for the local course HLS/video and thumbnail assets.
# When set, this takes precedence over VITE_CDN_URL for built-in course media.
# VITE_COURSE_MEDIA_BASE_URL=https://your-public-r2-domain.example
STATIC_BUILD_API_URL=http://localhost:4000/api/v1
# Browser-facing CDN URL. Use a full domain, or /cdn when the host routes
# /cdn/* to the Cloudflare Worker. Keep this equal to CDN_URL below.
VITE_CDN_URL=/cdn
# API/Worker CDN URL. The web build falls back to this when VITE_CDN_URL is unset.
CDN_URL=/cdn

# cdn configuration
CDN_URL=https://cdn.example.com
CDN_TOKEN_TTL_SECONDS=900
CDN_HLS_TOKEN_TTL_SECONDS=60
CDN_PUBLIC_FOLDERS=public,
CDN_PRIVATE_FOLDERS=protected
CDN_SIGNING_SECRET=32_character_secret_key_for_cdn_signing
# Both CDN values are used for course video/HLS, thumbnails, and media URLs.

# Security Configurations
# Must be at least 32 characters long
SESSION_SECRET=default_session_secret_at_least_32_chars_long
MFA_ENCRYPTION_KEY=default_mfa_encryption_key_at_least_32_chars_long
SETUP_TOKEN=veo_setup_token_123

# WebAuthn Passkeys Configurations
RP_ID=localhost
RP_NAME=VeoLMS

# TOTP Settings
TOTP_STEP_SECONDS=30
TOTP_BACKWARD_STEPS=1
TOTP_FORWARD_STEPS=0

# Accepts "mock_<email>" OAuth codes, bypassing the provider round-trip and the
# state/CSRF check. Only honoured when NODE_ENV=development as well. Never
# enable this on a deployed environment.
OAUTH_ALLOW_MOCK_CODES=false

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery Configuration (SMTP)
# EMAIL_TRANSPORT selects how mail leaves the process: "smtp" dispatches, and
# "console" only renders the message to the log. Leave it unset to default to
# console in development while SMTP_HOST is still localhost, and smtp otherwise
# (so a dev environment with real credentials does deliver).
# EMAIL_TRANSPORT=smtp
EMAIL_FROM=noreply@veolms.org
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# One-shot notification worker settings. Run with `pnpm notifications:process`
# from an external scheduler; retry delays are comma-separated seconds.
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_LEASE_SECONDS=300
NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_SECONDS=60,300,1800,7200
NOTIFICATION_OUTBOX_RETENTION_DAYS=30

# SMS Delivery Configuration
# Active provider: "auto" (default, prefers MSG91 when configured), "msg91", "vonage", "twilio", "console"
SMS_PROVIDER=auto

# MSG91 SMS Provider (Flow API)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_API_URL=https://control.msg91.com/api/v5/flow

# Vonage / Nexmo SMS Provider
SMS_PRIMARY_URL=https://api.nexmo.com/v1/messages
SMS_PRIMARY_KEY=
SMS_PRIMARY_SECRET=

# Twilio SMS Provider (optional backup or standalone provider)
SMS_BACKUP_URL=
SMS_BACKUP_SID=
SMS_BACKUP_TOKEN=
SMS_BACKUP_FROM=+1234567890

# S3 / Object Storage Configuration
# The API and media worker should use the same bucket and endpoint. The media
# worker accepts S3_* aliases for fleet deployments, but STORAGE_* wins when
# both are present.
STORAGE_ENDPOINT=
# Keep the bucket private. CDN_URL controls direct delivery; these folders are
# classified by the CDN Worker, with manifests public and protected segments
# requiring the short-lived token issued by the API.
CDN_SIGNING_SECRET=default_cdn_signing_secret_at_least_32_chars_long
CDN_TOKEN_TTL_SECONDS=900
CDN_HLS_TOKEN_TTL_SECONDS=900
CDN_PUBLIC_FOLDERS=public,thumbnails,course-hls,course-videos
CDN_PRIVATE_FOLDERS=protected,media,transcoded

STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=veolms-media
STORAGE_FORCE_PATH_STYLE=false

# ==============================================================================
# Commerce & Payment Gateway Configuration
# ==============================================================================
# Primary Payment Gateway (Razorpay)
# Required in production — server boot fails if these are missing (see packages/config).
# In development, leave blank to use the mock gateway fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Secret used to verify incoming Razorpay payment & refund webhook signatures
# (/webhooks/payments/razorpay).
RAZORPAY_WEBHOOK_SECRET=

# Note: Custom / merchant gateway credentials configured via API (/payments/gateway-config)
# are encrypted at rest using AES-256-GCM with MFA_ENCRYPTION_KEY or SESSION_SECRET.

# Fleet Manager Trigger Configuration (Serverless Video Processing)
# Option 1: Direct HTTP / Lambda Function URL trigger
# FLEET_MANAGER_TRIGGER_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
# Option 2: AWS Lambda SDK invoke
# FLEET_MANAGER_LAMBDA_NAME=veolms-fleet-manager
# FLEET_MANAGER_LAMBDA_REGION=us-east-1
# For local Floci, the infra wizard writes host-side endpoint settings to
# apps/fleet-manager/.env and apps/media-worker/.env. The Fleet CLI reads those
# generated app env files; the root .env is used for Compose interpolation.
# AWS_ENDPOINT_URL=http://localhost:4566
FLEET_MANAGER_HEARTBEAT_SECONDS=10

# Local Docker Fleet (set DOCKER_SOCKET_GID to `stat -c '%g' /var/run/docker.sock` on Linux)
# DOCKER_SOCKET_GID=0

TRUST_PROXY=false
# Set to true, proxy IP, or CIDR block behind a trusted reverse proxy/load balancer
# TRUST_PROXY=true

# YouTube playlist importer (`pnpm import:youtube`). Disk-backed scratch dir;
# do not use /tmp on Ubuntu (often tmpfs). Defaults to /var/lib/veolms/import,
# ~/.veolms/tmp, or /var/tmp.
# VEOLMS_IMPORT_TMP=/var/lib/veolms/import
