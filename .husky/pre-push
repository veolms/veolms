# Commit emails allowed to push straight to dev.
dev_push_allowed="rameshkumaryadav1918@gmail.com bhupeshkr2912@gmail.com"
push_email=$(git config user.email)

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/dev" ]; then
    case " $dev_push_allowed " in
      *" $push_email "*) ;;
      *)
        echo "Direct push to the dev branch is not allowed. Please use a feature/fix/chore branch and open a Pull Request."
        exit 1
        ;;
    esac
  fi
done

pnpm --filter @veolms/api test || {
  echo "API tests failed. Fix them before pushing."
  exit 1
}
