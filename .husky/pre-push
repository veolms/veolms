#!/usr/bin/env sh
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "development" ] || [ "$current_branch" = "dev" ] || [ "$current_branch" = "main" ]; then
  echo "❌ Direct push to '$current_branch' is forbidden. Open a Pull Request."
  exit 1
fi

echo "🔍 Verifying TypeScript contracts and types before push..."
pnpm typecheck
