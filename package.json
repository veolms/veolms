{
  "name": "veolms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@veolms/api --filter=@veolms/web",
    "dev:web": "pnpm --filter @veolms/web dev",
    "preview:web:device": "pnpm --filter @veolms/web preview:device",
    "dev:api": "pnpm --filter @veolms/api dev",
    "purge:course-deletions": "pnpm --filter @veolms/api purge:course-deletions",
    "notifications:process": "pnpm --filter @veolms/api notifications:process",
    "build": "turbo run build",
    "build:web": "pnpm --filter @veolms/web build",
    "build:api": "pnpm --filter @veolms/api build",
    "build:serverless": "pnpm --filter @veolms/fleet-manager build:serverless",
    "build:worker": "pnpm --filter @veolms/media-worker build:bundle",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @veolms/database migrate",
    "db:seed": "pnpm --filter @veolms/database seed",
    "db:reset": "pnpm --filter @veolms/database reset",
    "fleet:run": "pnpm --filter @veolms/fleet-manager run",
    "fleet:cli": "pnpm --filter @veolms/fleet-manager cli",
    "fleet:provider": "pnpm --filter @veolms/fleet-manager provider",
    "fleet:infra": "pnpm --filter @veolms/fleet-manager infra",
    "fleet:destroy": "pnpm --filter @veolms/fleet-manager destroy",
    "fleet:build-ami": "pnpm --filter @veolms/fleet-provider-aws build:ami",
    "fleet:bundle:upload": "pnpm --filter @veolms/fleet-manager bundle:upload",
    "fleet:queue:trigger": "pnpm --filter @veolms/fleet-manager queue:trigger",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.13",
    "@typescript/native": "catalog:",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
